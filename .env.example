# Copy to `.env` and fill in. `.env` is gitignored.
# Only the keys you intend to use need values; everything else can stay blank.

# Anthropic Claude (primary judge model)
ANTHROPIC_API_KEY=

# OpenAI (secondary judge / cross-validation)
OPENAI_API_KEY=

# Groq (open-weights via Llama 3.x)
GROQ_API_KEY=

# Optional: override default store path (defaults to ~/.ariadne/store.duckdb)
# ARIADNE_STORE_PATH=

# Optional: failure mode for tracing — strict | warn | silent
# ARIADNE_FAIL_MODE=strict
